{
  "manifest_version": 3,
  "name": "Genie",
  "description": "Genie Chrome extension.",
  "version": "0.1.0",
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Genie"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.floridaresourcemap.org/*",
        "https://floridaresourcemap.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
