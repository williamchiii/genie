{
  "manifest_version": 3,
  "name": "Genie",
  "description": "Genie Chrome extension.",
  "version": "0.1.0",
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ],
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Genie",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.floridaresourcemap.org/*",
        "https://floridaresourcemap.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.floridaresourcemap.org/*",
        "https://floridaresourcemap.org/*"
      ],
      "js": [
        "searchIntercept.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.floridaresourcemap.org/*",
        "https://floridaresourcemap.org/*"
      ],
      "js": [
        "search.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
